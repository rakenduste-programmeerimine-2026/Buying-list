# Kopeeri see fail nimega .env.development.local ja täida väärtused (vt backend/docs/BACKEND.md).
# Väärtused: Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<projekti-id>.supabase.co
# Ainult avalik võti. ÄRA pane siia service_role / sb_secret_ võtit!
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Uuemates projektides võib anon-võtme asemel kasutada publishable võtit:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Frontend: true = localStorage mock, false = päris backend (/api)
NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_API_BASE_URL=/api

# Rakenduse avalik aadress (kinnituskirjade linkide jaoks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
