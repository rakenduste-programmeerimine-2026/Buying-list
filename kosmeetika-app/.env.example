# Kopeeri see fail nimega .env.local ja täida väärtused.
# Väärtused: Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<projekti-id>.supabase.co
# Ainult avalik "anon" / "publishable" võti. ÄRA pane siia service_role võtit!
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Frontend: true = localStorage mock, false = päris backend (/api)
NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_API_BASE_URL=/api

# Rakenduse avalik aadress (kinnituskirjade linkide jaoks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
