# Supabase keskkonnamuutujad
# Kopeeri see fail nimega .env.local ja täida päris väärtustega:
#   cp .env.example .env.local
# Väärtused leiad: Supabase Dashboard -> Project Settings -> API
# ÄRA commiti .env.local faili ega päris võtmeid!

# Projekti URL (avalik, kasutatakse brauseris ja serveris)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable võti (avalik, turvalisus tuleb RLS reeglitest)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role võti: AINULT serveris (API routes, server actions, skriptid).
# Möödub RLS-ist. Ära kunagi lisa sellele NEXT_PUBLIC_ eesliidet.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
